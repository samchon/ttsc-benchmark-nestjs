{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "importHelpers": true,
    "removeComments": false,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false,
    "target": "es2017",
    "sourceMap": false,
    "allowJs": false,
    "strict": true,
    "strictNullChecks": false,
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "..",
    "paths": {
      "@nestjs/common": ["../common"],
      "@nestjs/common/*": ["../common/*"],
      "@nestjs/core": ["../core"],
      "@nestjs/core/*": ["../core/*"],
      "@nestjs/websockets": ["../websockets"],
      "@nestjs/websockets/*": ["../websockets/*"]
    },
    "plugins": [
      {
        "transform": "@ttsc/lint"
      }
    ]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "test/**/*", "*.spec.ts"]
}
